# =============================================================================
# Message Scheduler — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# At minimum, set TELEGRAM_BOT_TOKEN to enable message sending.
# =============================================================================

# --- Required for sending ---
# Telegram Bot Token from @BotFather on Telegram.
# Without this, messages will queue but never send.
TELEGRAM_BOT_TOKEN=

# --- Optional: Bridge for multi-platform sending ---
# If you have a Hermes agent or custom bridge running on the host,
# set its URL here. Otherwise only Telegram sending works.
# On Linux:    http://host.docker.internal:9190
# On macOS:    http://host.docker.internal:9190
# On Windows:  http://host.docker.internal:9190
# Direct LAN:  http://192.168.x.x:9190
HERMES_BRIDGE_URL=http://host.docker.internal:9190

# --- Optional: Scheduler base URL (for file attachment serving) ---
# The URL clients use to reach this scheduler. Used when the bridge
# needs to download uploaded files for sending.
# Examples: http://localhost:9119, http://192.168.1.100:9119
SCHEDULER_BASE_URL=http://localhost:9119

# --- Optional: Contact sync sources ---
# Birthday contacts database path (SQLite with columns:
# name, whatsapp_chat_id, telegram_chat_id, facebook_chat_id, etc.)
# Leave empty to skip birthday DB sync.
BIRTHDAY_DB=

# Beeper Desktop API token (for Beeper contact sync)
# Get this from Beeper Desktop: Settings → Developer → Approved connections
BEEPER_TOKEN=
BEEPER_URL=http://127.0.0.1:23373

# --- Optional: Server config ---
# PORT=9119
# MESSAGE_SCHEDULER_DB=/app/data/scheduler.db
